                "header_size": "h2",
                "align": "center"
              }
            },
            {
              "id": "faq_accordion",
              "elType": "widget",
              "widgetType": "accordion",
              "settings": {
                "tabs": [
                  {
                    "tab_title": "Where is Chitran Institute located in Hyderabad?",
                    "tab_content": "We are located at Street Number 10, P & T Colony, Ashok Nagar, Himayatnagar, Hyderabad, Telangana 500020 (near Ashok Nagar Circle)."
                  },
                  {
                    "tab_title": "Do you offer both offline and online classes?",
                    "tab_content": "Yes, we conduct offline classes at our Ashok Nagar campus and live online interactive classes for students globally across USA, UK, Germany, and Australia."
                  },
                  {
                    "tab_title": "Can beginners join?",
                    "tab_content": "Yes! Our courses start from foundational basics, accommodating all skill levels and ages from 4.5+ to adults."
                  },
                  {
                    "tab_title": "What are the class timings?",
                    "tab_content": "We have flexible morning, evening, and weekend batches operating Monday to Saturday (9:00 AM – 8:00 PM) and Sundays (9:00 AM – 2:00 PM)."
                  }
                ]
              }
            }
          ]
        }
