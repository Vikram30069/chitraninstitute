              "settings": {
                "title": "✨ HYDERABAD'S PREMIER ART & MUSIC ACADEMY SINCE 2003 | MSME CERTIFIED",
                "header_size": "h6",
                "align": "center",
                "title_color": "#e0a96d"
              }
            },
            {
              "id": "hero_title",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Professional Drawing, Music & Dance Classes in Hyderabad",
                "header_size": "h1",
                "align": "center",
                "title_color": "#ffffff"
              }
            },
            {
              "id": "hero_description",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p style='text-align: center; color: #e0e1dd; font-size: 18px; max-width: 800px; margin: 0 auto;'>Join over 5,000+ students and budding artists. Learn drawing, painting, piano, guitar, drums, dance, handwriting and abacus from award-winning mentors. Offline batches at Ashok Nagar + Live interactive online classes globally.</p>",
                "align": "center"
              }
            },
            {
              "id": "hero_cta_btn",
              "elType": "widget",
              "widgetType": "button",
              "settings": {
                "text": "Book a Free Assessment / Trial Class",
                "link": { "url": "https://chitraninstitute.com/contact/" },
                "align": "center",
                "button_type": "success",
                "size": "lg"
              }
            }
          ]
        }
      ]
