              "id": "test_box_1",
              "elType": "widget",
              "widgetType": "testimonial",
              "settings": {
                "testimonial_content": "Our daughter Tripthi takes art classes at Chitran Institute under Raj Kumar Sir and Sujatha Ma'am since 2020. She secured first class with distinction in pre-primary levels and won 1st position in the Nabagitika Painting Competition and a medal in the 5th National Level Painting Competition!",
                "testimonial_name": "Parents of Tripthi",
                "testimonial_job": "Student since 2020 (Drawing & Keyboard)"
              }
            }
          ]
