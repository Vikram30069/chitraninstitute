    {
      "id": "curriculum_section",
      "elType": "section",
      "settings": {
        "padding": { "unit": "px", "top": "70", "right": "20", "bottom": "70", "left": "20", "isLinked": false }
      },
      "elements": [
        {
          "id": "curriculum_col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "curriculum_heading",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Comprehensive Course Curriculum & Levels",
                "header_size": "h2",
                "align": "center"
              }
            },
            {
              "id": "curriculum_accordion",
              "elType": "widget",
              "widgetType": "accordion",
              "settings": {
                "tabs": [
                  {
                    "tab_title": "Level 1: Junior Foundations (Ages 4.5 – 8)",
                    "tab_content": "Pencil grip control, freehand shapes, color identification, crayons, oil pastels, and basic cartooning."
                  },
                  {
                    "tab_title": "Level 2: Intermediate Mastery (Ages 9 – 15)",
                    "tab_content": "Pencil shading (2B-8B), light-and-shade, watercolor washes, perspective, landscape sketching, and still life."
                  },
                  {
                    "tab_title": "Level 3: Advanced & Hobbyists (Ages 16+ & Adults)",
                    "tab_content": "Canvas acrylics, classical oil painting, portrait sketching, palette knife textures, and traditional Tanjore art."
                  },
                  {
                    "tab_title": "Level 4: Fine Arts Diploma & Exam Coaching",
                    "tab_content": "Prescribed syllabus for Board/University Fine Arts diplomas, theoretical art history, portfolio curation, and mock exams."
                  }
                ]
              }
            }
          ]
        }
      ]
    },
