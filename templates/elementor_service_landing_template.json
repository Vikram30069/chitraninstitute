{
  "version": "0.4",
  "title": "Chitran Institute - High Converting SEO Service Landing Page",
  "type": "page",
  "content": [
    {
      "id": "hero_section",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "background_background": "gradient",
        "background_color": "#0d1b2a",
        "background_color_b": "#1b263b",
        "background_gradient_angle": { "unit": "deg", "size": 135 },
        "padding": { "unit": "px", "top": "90", "right": "20", "bottom": "90", "left": "20", "isLinked": false }
      },
      "elements": [
        {
          "id": "hero_column",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "hero_badge",
