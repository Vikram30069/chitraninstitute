          "id": "hero_aarabhi_slider_col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "hero_aarabhi_slides_widget",
              "elType": "widget",
              "widgetType": "slides",
              "settings": {
                "slides": [
                  {
                    "heading": "Mastery on Canvas",
                    "description": "Preserving the timeless tradition of Indian Fine Arts, authentic 22K Tanjore gold foil, and oil realism since 2003 under Suryachandra Awardee Guru Rajkumar Banerjee.",
                    "button_text": "EXPLORE FINE ARTS",
                    "link": { "url": "https://chitraninstitute.com/drawing-painting-classes-hyderabad/" },
                    "background_color": "#070B14",
                    "background_overlay": "yes",
                    "background_overlay_color": "rgba(7, 11, 20, 0.65)"
                  },
                  {
                    "heading": "Symphony of Strings & Keys",
                    "description": "Witness the breathtaking harmony of over 500+ youth students mastering western staff notation, classical Carnatic ragas, acoustic guitar chords, and stage symphony.",
                    "button_text": "EXPLORE MUSIC",
                    "link": { "url": "https://chitraninstitute.com/music-classes-hyderabad/" },
                    "background_color": "#070B14",
                    "background_overlay": "yes",
                    "background_overlay_color": "rgba(7, 11, 20, 0.65)"
                  },
                  {
                    "heading": "Rhythm & Grace in Motion",
                    "description": "From sacred classical temple mudras and footwork of ancient Kuchipudi to high-voltage contemporary and Bollywood routines. Complete stage training & certified syllabus.",
                    "button_text": "EXPLORE DANCE",
                    "link": { "url": "https://chitraninstitute.com/dance-classes-hyderabad/" },
                    "background_color": "#070B14",
                    "background_overlay": "yes",
                    "background_overlay_color": "rgba(7, 11, 20, 0.65)"
                  },
                  {
                    "heading": "The Art of Penmanship",
                    "description": "Transform handwriting speed, legibility, and pencil grip ergonomics in just one month. Scientifically formulated for school students, teens, and competitive exam aspirants.",
                    "button_text": "EXPLORE HANDWRITING",
                    "link": { "url": "https://chitraninstitute.com/handwriting-classes-hyderabad/" },
                    "background_color": "#070B14",
                    "background_overlay": "yes",
                    "background_overlay_color": "rgba(7, 11, 20, 0.65)"
                  }
                ],
                "slides_height": { "unit": "vh", "size": 92 },
                "navigation": "both",
                "autoplay": "yes",
                "autoplay_speed": 5500,
                "pause_on_hover": "yes",
